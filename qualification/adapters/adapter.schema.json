{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "sandboxed",
    "workspace_isolation",
    "capabilities",
    "command",
    "agent"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "command"
      ]
    },
    "sandboxed": {
      "type": "boolean"
    },
    "workspace_isolation": {
      "enum": [
        "none",
        "process",
        "sandbox",
        "container",
        "vm"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "skill_install_command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "usage_file": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "required": [
        "family",
        "model_id",
        "scaffold_version"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "scaffold_version": {
          "type": "string"
        }
      }
    }
  }
}
