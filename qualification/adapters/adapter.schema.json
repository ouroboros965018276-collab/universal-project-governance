{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "sandboxed",
    "workspace_isolation",
    "capabilities",
    "command",
    "agent",
    "host_tool"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "command"
      ]
    },
    "sandboxed": {
      "type": "boolean"
    },
    "workspace_isolation": {
      "enum": [
        "none",
        "process",
        "sandbox",
        "container",
        "vm"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "adapter_runtime_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "skill_install_command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "environment_passthrough": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "usage_file": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "required": [
        "family",
        "model_id",
        "scaffold_version"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "scaffold_version": {
          "type": "string"
        }
      }
    },
    "tool_profile": {
      "type": "string"
    },
    "budget_profile": {
      "type": "string"
    },
    "host_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolation_attestation": {
      "type": "object",
      "required": [
        "issuer",
        "reference",
        "sha256"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
