{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "pair_id",
    "scenario_id",
    "kind",
    "arm",
    "agent",
    "environment",
    "fingerprints",
    "safety_exposures",
    "outcome",
    "usage",
    "evidence",
    "round_id",
    "repetition",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "trial_id": {
      "type": "string"
    },
    "pair_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "behavioral",
        "handoff",
        "trigger",
        "mutation",
        "ablation"
      ]
    },
    "arm": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "K"
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "family",
        "model_id",
        "scaffold_version"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "scaffold_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "qualification_set",
        "sandboxed",
        "workspace_isolation",
        "adapter_config_sha256",
        "adapter_runtime_sha256",
        "host_tool_name",
        "host_tool_version"
      ],
      "properties": {
        "qualification_set": {
          "enum": [
            "dev",
            "locked"
          ]
        },
        "project_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "budget_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_config_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adapter_runtime_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "host_tool_name": {
          "type": "string",
          "minLength": 1
        },
        "host_tool_version": {
          "type": "string",
          "minLength": 1
        },
        "source_agent_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_adapter_config_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_host_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_host_tool_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandboxed": {
          "type": "boolean"
        },
        "workspace_isolation": {
          "enum": [
            "none",
            "process",
            "sandbox",
            "container",
            "vm"
          ]
        },
        "isolation_attestation": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "issuer",
            "reference",
            "sha256"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "required": [
        "behavioral",
        "qualification"
      ],
      "properties": {
        "behavioral": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "qualification": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "safety_exposures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "task_success": {
          "type": "boolean"
        },
        "governance_defect_free": {
          "type": "boolean"
        },
        "handoff_degraded": {
          "type": "boolean"
        },
        "eval_detected_regression": {
          "type": "boolean"
        },
        "should_trigger": {
          "type": "boolean"
        },
        "triggered": {
          "type": "boolean"
        },
        "critical_failures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scope_metrics": {
          "type": "object"
        },
        "deployment": {
          "type": "object",
          "properties": {
            "binding_ok": {
              "type": "boolean"
            },
            "report_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "total_tokens": {
          "type": "number",
          "minimum": 0
        },
        "wall_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "tool_calls": {
          "type": "number",
          "minimum": 0
        },
        "governance_context_tokens": {
          "type": "number",
          "minimum": 0
        },
        "persistent_task_governance_artifacts": {
          "type": "number",
          "minimum": 0
        },
        "managed_project_files": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "exit_code",
        "artifact_manifest",
        "artifact_manifest_sha256"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "artifact_manifest": {
          "type": "string",
          "minLength": 1
        },
        "artifact_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
