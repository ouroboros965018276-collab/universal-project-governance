{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "pair_id",
    "scenario_id",
    "kind",
    "arm",
    "agent",
    "environment",
    "fingerprints",
    "safety_exposures",
    "outcome",
    "usage",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "trial_id": {
      "type": "string"
    },
    "pair_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "behavioral",
        "handoff",
        "trigger",
        "mutation",
        "ablation"
      ]
    },
    "arm": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "K"
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "family",
        "model_id",
        "scaffold_version"
      ]
    },
    "environment": {
      "type": "object",
      "required": [
        "qualification_set"
      ],
      "properties": {
        "qualification_set": {
          "enum": [
            "dev",
            "locked"
          ]
        },
        "project_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "budget_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_config_sha256": {
          "type": "string"
        },
        "adapter_runtime_sha256": {
          "type": "string"
        },
        "host_tool_name": {
          "type": "string"
        },
        "host_tool_version": {
          "type": "string"
        },
        "source_agent_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_adapter_config_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_host_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_host_tool_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fingerprints": {
      "type": "object"
    },
    "safety_exposures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "object"
    },
    "usage": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    }
  }
}
