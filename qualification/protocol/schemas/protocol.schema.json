{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "arms",
    "primary_endpoints",
    "critical_failure_classes",
    "sampling",
    "grading",
    "holdout",
    "stopping"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "runtime_semantics": {
      "type": "string"
    },
    "design": {
      "type": "object"
    },
    "arms": {
      "type": "object"
    },
    "primary_endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "secondary_endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "critical_failure_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sampling": {
      "type": "object"
    },
    "randomization": {
      "type": "object"
    },
    "grading": {
      "type": "object"
    },
    "holdout": {
      "type": "object"
    },
    "stopping": {
      "type": "object"
    }
  }
}
