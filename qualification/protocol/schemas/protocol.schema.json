{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "arms",
    "gate_order",
    "critical_failure_classes",
    "sampling",
    "coverage",
    "safety_exposure_model",
    "evaluator_validity",
    "grading",
    "holdout",
    "stopping",
    "inference",
    "structural_overreach"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "protocol_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "runtime_semantics": {
      "type": "string"
    },
    "design": {
      "type": "object"
    },
    "arms": {
      "type": "object"
    },
    "gate_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "critical_failure_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sampling": {
      "type": "object"
    },
    "coverage": {
      "type": "object"
    },
    "safety_exposure_model": {
      "type": "object"
    },
    "evaluator_validity": {
      "type": "object"
    },
    "randomization": {
      "type": "object"
    },
    "grading": {
      "type": "object"
    },
    "holdout": {
      "type": "object"
    },
    "stopping": {
      "type": "object"
    },
    "inference": {
      "type": "object"
    },
    "structural_overreach": {
      "type": "object"
    }
  }
}
