{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_fingerprint",
    "trials"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "qualification_fingerprint": {
      "type": "string"
    },
    "trials": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "trial_id",
          "pair_id",
          "scenario_id",
          "kind",
          "arm",
          "agent",
          "environment",
          "fingerprints",
          "safety_exposures",
          "outcome",
          "usage",
          "evidence"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "trial_id": {
            "type": "string"
          },
          "pair_id": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "behavioral",
              "handoff",
              "trigger",
              "mutation",
              "ablation"
            ]
          },
          "arm": {
            "enum": [
              "A0",
              "A1",
              "A2",
              "K"
            ]
          },
          "agent": {
            "type": "object",
            "required": [
              "family",
              "model_id",
              "scaffold_version"
            ]
          },
          "environment": {
            "type": "object",
            "required": [
              "qualification_set"
            ],
            "properties": {
              "qualification_set": {
                "enum": [
                  "dev",
                  "locked"
                ]
              },
              "project_profile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool_profile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "budget_profile": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "fingerprints": {
            "type": "object"
          },
          "safety_exposures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "object"
          },
          "usage": {
            "type": "object"
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
