{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Project Governance State",
  "description": "Optional machine-readable alternative to prose project-state files. Do not maintain both independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated_at",
    "sources_of_truth",
    "last_change",
    "previous_change",
    "active_exceptions"
  ],
  "properties": {
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp with timezone or UNRESOLVED"
    },
    "sources_of_truth": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concern",
          "source"
        ],
        "properties": {
          "concern": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "last_change": {
      "$ref": "#/$defs/change"
    },
    "previous_change": {
      "anyOf": [
        {
          "$ref": "#/$defs/change"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "scope",
        "before",
        "what",
        "why",
        "after",
        "validation"
      ],
      "properties": {
        "when": {
          "type": "string"
        },
        "change_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "before": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "impact": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "removed_or_superseded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "constraint",
        "reason",
        "risk",
        "scope",
        "removal_condition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "constraint": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mitigation": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "removal_condition": {
          "type": "string"
        },
        "review_trigger": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
