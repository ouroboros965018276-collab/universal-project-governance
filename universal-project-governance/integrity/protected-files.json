{
  "schema_version": 1,
  "policy": "protect-all",
  "root": ".",
  "exclude": [
    "integrity/checksums.json"
  ],
  "ignore_names": [
    "__pycache__",
    ".DS_Store"
  ],
  "ignore_suffixes": [
    ".pyc",
    ".pyo"
  ],
  "require_explicit_user_authorization": true,
  "refresh_command": "python3 scripts/refresh_integrity.py . --confirm-governance-upgrade"
}
