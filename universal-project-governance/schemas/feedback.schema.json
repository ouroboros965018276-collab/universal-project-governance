{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated_at",
    "items"
  ],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "observation",
          "evidence",
          "consequence",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "observation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "consequence": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "project",
              "skill"
            ]
          },
          "proposed_improvement": {
            "type": "string"
          }
        }
      },
      "$comment": "An empty collection means no outstanding feedback. Every recorded observation requires evidence; consumers enforce unique item IDs."
    }
  }
}
