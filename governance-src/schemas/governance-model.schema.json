{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "hot_path",
    "risk_model",
    "default_rules",
    "policies",
    "structural_integration",
    "project_binding",
    "complexity_budget"
  ],
  "properties": {
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_order"
      ],
      "properties": {
        "policy_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "hot_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "default_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "severity",
          "closure",
          "report",
          "handoff",
          "id",
          "triggers",
          "requires",
          "conflicts_with",
          "applies_to",
          "evidence",
          "eval_tags"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "closure": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "report": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "handoff": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operations",
              "domains",
              "signals"
            ],
            "properties": {
              "operations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "domains": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "signals": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "conflicts_with": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "applies_to": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "eval_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "complexity_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_skill_max_lines",
        "hot_path_max",
        "default_active_policies_max",
        "runtime_markdown_files_max",
        "canonical_definition_per_rule",
        "orphan_policies_max",
        "dependency_cycles_max",
        "conflicting_blocking_rules_max",
        "unused_profile_activations_max",
        "persistent_current_handoffs_max",
        "persistent_current_execution_reports_max",
        "managed_project_files_max"
      ],
      "properties": {
        "runtime_skill_max_lines": {
          "type": "integer",
          "minimum": 0
        },
        "hot_path_max": {
          "type": "integer",
          "minimum": 0
        },
        "default_active_policies_max": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_markdown_files_max": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_definition_per_rule": {
          "type": "integer",
          "minimum": 0
        },
        "orphan_policies_max": {
          "type": "integer",
          "minimum": 0
        },
        "dependency_cycles_max": {
          "type": "integer",
          "minimum": 0
        },
        "conflicting_blocking_rules_max": {
          "type": "integer",
          "minimum": 0
        },
        "unused_profile_activations_max": {
          "type": "integer",
          "minimum": 0
        },
        "persistent_current_handoffs_max": {
          "type": "integer",
          "minimum": 0
        },
        "persistent_current_execution_reports_max": {
          "type": "integer",
          "minimum": 0
        },
        "managed_project_files_max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "structural_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "minimum_risk_level",
        "force_operations",
        "exempt_operations",
        "scope_guard"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "minimum_risk_level": {
          "enum": [
            "trivial",
            "low",
            "medium",
            "high"
          ]
        },
        "force_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "exempt_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scope_guard": {
          "enum": [
            "task-bounded-responsible-layer"
          ]
        }
      }
    },
    "project_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_file",
        "field_report_file",
        "field_test_reporting",
        "max_reports",
        "managed_files_max",
        "adoption_mode",
        "continuity_mode",
        "capability_handshake"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "binding_file": {
          "type": "string"
        },
        "field_report_file": {
          "type": "string"
        },
        "field_test_reporting": {
          "type": "boolean"
        },
        "max_reports": {
          "type": "integer",
          "minimum": 1
        },
        "managed_files_max": {
          "type": "integer",
          "minimum": 1
        },
        "adoption_mode": {
          "enum": [
            "in-place"
          ]
        },
        "continuity_mode": {
          "enum": [
            "handoff-or-reconstruct"
          ]
        },
        "capability_handshake": {
          "enum": [
            "observe-before-assume"
          ]
        },
        "git_checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "min_interval_seconds",
            "allowed_paths",
            "status_paths",
            "bootstrap",
            "watcher"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "min_interval_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400,
              "default": 300
            },
            "allowed_paths": {
              "type": "array",
              "maxItems": 1024,
              "default": [],
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "status_paths": {
              "type": "array",
              "maxItems": 1024,
              "default": [],
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "bootstrap": {
              "type": "boolean",
              "default": true
            },
            "watcher": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "configuration",
                "supervisor"
              ],
              "default": {
                "configuration": {
                  "enabled": false,
                  "poll_seconds": 5,
                  "quiet_seconds": 15,
                  "validators": []
                },
                "supervisor": {
                  "enabled": false
                }
              },
              "properties": {
                "configuration": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled",
                    "poll_seconds",
                    "quiet_seconds",
                    "validators"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "poll_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 60
                    },
                    "quiet_seconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3600
                    },
                    "validators": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "argv",
                          "timeout_seconds"
                        ],
                        "properties": {
                          "argv": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096
                            }
                          },
                          "timeout_seconds": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 300
                          }
                        }
                      }
                    }
                  }
                },
                "supervisor": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "default": {
                    "enabled": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "operational_guidance": {
      "type": "array",
      "description": "Existing workflow instructions selected once by active policy IDs or existing field-reporting state; no new policies or user configuration switch.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "policy_ids",
          "on_field_reporting",
          "statement",
          "report_levels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "policy_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "on_field_reporting": {
            "type": "boolean"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "report_levels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "none",
                "change-note",
                "engineering",
                "audit"
              ]
            }
          }
        }
      }
    },
    "architecture": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "principles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "execution_guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "policy_ids",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "policy_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "minItems": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "risk_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "levels",
        "release_operation_forces"
      ],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "weight",
              "max"
            ],
            "properties": {
              "weight": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "min",
              "max",
              "report"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 0
              },
              "report": {
                "enum": [
                  "none",
                  "change-note",
                  "engineering",
                  "audit"
                ]
              }
            }
          }
        },
        "release_operation_forces": {
          "enum": [
            "audit"
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "$comment": "Compiler and governance_lint enforce policy ID uniqueness and referential integrity beyond schema validation. Release is an operation-specific risk override whose report is defined by release_operation_forces, outside scored levels."
}
