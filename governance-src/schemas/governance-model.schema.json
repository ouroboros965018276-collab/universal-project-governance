{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "hot_path",
    "risk_model",
    "default_rules",
    "policies",
    "structural_integration",
    "project_binding",
    "complexity_budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "hot_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "default_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "severity",
          "triggers",
          "requires",
          "conflicts_with",
          "applies_to",
          "closure",
          "evidence",
          "report",
          "handoff",
          "eval_tags"
        ]
      }
    },
    "complexity_budget": {
      "type": "object"
    },
    "structural_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "minimum_risk_level",
        "force_operations",
        "exempt_operations",
        "scope_guard"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "minimum_risk_level": {
          "enum": [
            "trivial",
            "low",
            "medium",
            "high"
          ]
        },
        "force_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "exempt_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scope_guard": {
          "enum": [
            "task-bounded-responsible-layer"
          ]
        }
      }
    },
    "project_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_file",
        "field_report_file",
        "field_test_reporting",
        "max_reports",
        "managed_files_max",
        "adoption_mode",
        "continuity_mode",
        "capability_handshake"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "binding_file": {
          "type": "string"
        },
        "field_report_file": {
          "type": "string"
        },
        "field_test_reporting": {
          "type": "boolean"
        },
        "max_reports": {
          "type": "integer"
        },
        "managed_files_max": {
          "type": "integer"
        },
        "adoption_mode": {
          "enum": [
            "in-place"
          ]
        },
        "continuity_mode": {
          "enum": [
            "handoff-or-reconstruct"
          ]
        },
        "capability_handshake": {
          "enum": [
            "observe-before-assume"
          ]
        }
      }
    }
  }
}
