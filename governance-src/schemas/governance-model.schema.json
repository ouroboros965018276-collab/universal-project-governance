{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "hot_path",
    "risk_model",
    "default_rules",
    "policies",
    "structural_integration",
    "project_binding",
    "complexity_budget"
  ],
  "properties": {
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_order"
      ],
      "properties": {
        "policy_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "hot_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "default_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "severity",
          "triggers",
          "requires",
          "conflicts_with",
          "applies_to",
          "closure",
          "evidence",
          "report",
          "handoff",
          "eval_tags"
        ]
      }
    },
    "complexity_budget": {
      "type": "object"
    },
    "structural_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "minimum_risk_level",
        "force_operations",
        "exempt_operations",
        "scope_guard"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "minimum_risk_level": {
          "enum": [
            "trivial",
            "low",
            "medium",
            "high"
          ]
        },
        "force_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "exempt_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scope_guard": {
          "enum": [
            "task-bounded-responsible-layer"
          ]
        }
      }
    },
    "project_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_file",
        "field_report_file",
        "field_test_reporting",
        "max_reports",
        "managed_files_max",
        "adoption_mode",
        "continuity_mode",
        "capability_handshake"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "binding_file": {
          "type": "string"
        },
        "field_report_file": {
          "type": "string"
        },
        "field_test_reporting": {
          "type": "boolean"
        },
        "max_reports": {
          "type": "integer"
        },
        "managed_files_max": {
          "type": "integer"
        },
        "adoption_mode": {
          "enum": [
            "in-place"
          ]
        },
        "continuity_mode": {
          "enum": [
            "handoff-or-reconstruct"
          ]
        },
        "capability_handshake": {
          "enum": [
            "observe-before-assume"
          ]
        },
        "git_checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "min_interval_seconds",
            "allowed_paths",
            "status_paths",
            "bootstrap",
            "watcher"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "min_interval_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400,
              "default": 300
            },
            "allowed_paths": {
              "type": "array",
              "maxItems": 1024,
              "default": [],
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "status_paths": {
              "type": "array",
              "maxItems": 1024,
              "default": [],
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "bootstrap": {
              "type": "boolean",
              "default": true
            },
            "watcher": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "configuration"
              ],
              "default": {
                "configuration": {
                  "enabled": false,
                  "poll_seconds": 5,
                  "quiet_seconds": 15,
                  "validators": []
                }
              },
              "properties": {
                "configuration": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled",
                    "poll_seconds",
                    "quiet_seconds",
                    "validators"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "poll_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 60
                    },
                    "quiet_seconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3600
                    },
                    "validators": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "argv",
                          "timeout_seconds"
                        ],
                        "properties": {
                          "argv": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096
                            }
                          },
                          "timeout_seconds": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 300
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "operational_guidance": {
      "type": "array",
      "description": "Existing workflow instructions selected once by active policy IDs or existing field-reporting state; no new policies or user configuration switch.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "policy_ids",
          "on_field_reporting",
          "statement",
          "report_levels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "policy_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "on_field_reporting": {
            "type": "boolean"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "report_levels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "none",
                "change-note",
                "engineering",
                "audit"
              ]
            }
          }
        }
      }
    }
  }
}
