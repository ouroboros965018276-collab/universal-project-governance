{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "change_mode",
    "scope_guard",
    "risk_level",
    "risk_score",
    "active_rules",
    "required_closures",
    "evidence",
    "report",
    "field_report_obligation",
    "handoff"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "trivial",
        "low",
        "medium",
        "high",
        "release"
      ]
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "active_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "required_closures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report": {
      "enum": [
        "none",
        "change-note",
        "engineering",
        "audit"
      ]
    },
    "field_report_obligation": {
      "enum": [
        "required-before-completion",
        "not-required"
      ]
    },
    "field_report_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "handoff": {
      "enum": [
        "not-required",
        "required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_mode": {
      "enum": [
        "local",
        "structural"
      ]
    },
    "scope_guard": {
      "enum": [
        "local-only",
        "task-bounded-responsible-layer"
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "static",
            "specialist-needed"
          ]
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          },
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          },
          "maxItems": 8,
          "minItems": 1,
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          },
          "maxItems": 8,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "triggers",
        "steps",
        "constraints"
      ]
    }
  },
  "description": "Task projection used with the loaded Skill. Its four execution guidance groups remain in the Skill. required_closures contains active policy closures and each applicable source-derived operational block once; operational blocks do not add policies. Without helpers apply the Skill and matching policy-index routing.",
  "allOf": [
    {
      "if": {
        "properties": {
          "field_report_obligation": {
            "enum": [
              "required-before-completion"
            ]
          }
        },
        "required": [
          "field_report_obligation"
        ]
      },
      "then": {
        "required": [
          "field_report_file"
        ],
        "properties": {
          "field_report_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_mode": {
            "enum": [
              "structural"
            ]
          }
        },
        "required": [
          "change_mode"
        ]
      },
      "then": {
        "properties": {
          "scope_guard": {
            "const": "task-bounded-responsible-layer"
          }
        }
      },
      "else": {
        "properties": {
          "scope_guard": {
            "const": "local-only"
          }
        }
      }
    }
  ]
}
