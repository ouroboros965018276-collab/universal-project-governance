{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "change_mode",
    "scope_guard",
    "risk_level",
    "risk_score",
    "active_rules",
    "required_closures",
    "evidence",
    "report",
    "field_report_obligation",
    "handoff"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "trivial",
        "low",
        "medium",
        "high",
        "release"
      ]
    },
    "risk_score": {
      "type": "integer"
    },
    "active_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_closures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report": {
      "enum": [
        "none",
        "change-note",
        "engineering",
        "audit"
      ]
    },
    "field_report_obligation": {
      "enum": [
        "required-before-completion",
        "not-required"
      ]
    },
    "field_report_file": {
      "type": "string"
    },
    "handoff": {
      "enum": [
        "not-required",
        "required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_mode": {
      "enum": [
        "local",
        "structural"
      ]
    },
    "scope_guard": {
      "enum": [
        "local-only",
        "task-bounded-responsible-layer"
      ]
    }
  }
}
