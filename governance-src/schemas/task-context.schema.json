{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "domains"
  ],
  "properties": {
    "operation": {
      "enum": [
        "edit",
        "refactor",
        "delete",
        "migration",
        "dependency",
        "generated",
        "architecture",
        "security",
        "data",
        "docs",
        "release",
        "governance_upgrade"
      ]
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "code",
          "api",
          "schema",
          "config",
          "data",
          "docs",
          "infra",
          "security",
          "ml",
          "automation",
          "design",
          "generated",
          "governance"
        ]
      }
    },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unfinished": {
      "type": "boolean"
    },
    "explicit_audit": {
      "type": "boolean"
    },
    "risk": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      }
    }
  }
}
