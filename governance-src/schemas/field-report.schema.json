{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "recorded_at",
    "runtime_version",
    "task",
    "status",
    "change_mode",
    "scope_guard",
    "risk_level",
    "active_rules",
    "changed_files",
    "validation",
    "cleanup",
    "structural_scope",
    "integrity",
    "handoff",
    "feedback",
    "workflow_id",
    "epoch",
    "event_id",
    "change"
  ],
  "properties": {
    "completion_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "audit", "files"],
      "properties": {
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence", "findings"],
          "properties": {
            "status": {"enum": ["passed", "failed", "pending"]},
            "evidence": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}},
            "findings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}}
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence", "findings"],
          "properties": {
            "status": {"enum": ["passed", "failed", "pending"]},
            "evidence": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}},
            "findings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}}
          }
        },
        "files": {
          "type": "array", "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "executable"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 1024},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "executable": {"type": "integer", "minimum": 0, "maximum": 73}
            }
          }
        }
      },
      "description": "Final affected-state review and audit receipt. Required by the lifecycle for new normal completion; optional in historical records. Hashes and executable bits establish fixity, never semantic review by themselves. Deleted files use a null digest and zero executable bits."
    },
    "git_boundary": {
      "type": "string",
      "enum": [
        "verified",
        "handoff",
        "risk"
      ],
      "description": "Actual stage boundary for opt-in automatic Git checkpoints. Updating the handoff document alone does not bypass coalescing. Completion flushes automatically."
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Stable partial/blocked stage identity. Exact retries are idempotent; new observed stages use a new ID.",
      "$comment": "New partial/blocked checkpoints use stable stage IDs. Omission remains readable for legacy single-stage outcomes; further distinct stages require checkpoint_id. Complete outcomes reject checkpoint_id in the lifecycle validator."
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Reference to the existing project current-state JSON, not a copy or historical completion record."
    },
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_version": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "change_mode": {
      "enum": [
        "local",
        "structural"
      ]
    },
    "scope_guard": {
      "enum": [
        "local-only",
        "task-bounded-responsible-layer"
      ]
    },
    "risk_level": {
      "enum": [
        "trivial",
        "low",
        "medium",
        "high",
        "release"
      ]
    },
    "active_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "structural_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_layer",
        "unrelated_changes",
        "api_changes",
        "architecture_changes",
        "overreach_concern"
      ],
      "properties": {
        "canonical_layer": {
          "type": "string"
        },
        "unrelated_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architecture_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overreach_concern": {
          "type": "boolean"
        }
      }
    },
    "integrity": {
      "enum": [
        "pass",
        "fail",
        "not-checked"
      ]
    },
    "handoff": {
      "enum": [
        "not-required",
        "created",
        "updated",
        "closed"
      ]
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scaffold_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "$comment": "Partial observed provenance is allowed; omitted dimensions remain unknown and never qualify as complete qualification identity."
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "before",
        "after",
        "rationale",
        "source",
        "base_revision",
        "result_revision",
        "validation_revision",
        "occurred_at",
        "time_source",
        "parent_event_id"
      ],
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(unknown|[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
        },
        "result_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(unknown|[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
        },
        "validation_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(unknown|[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
        },
        "time_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "start_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "before",
        "after",
        "rationale",
        "source",
        "base_revision",
        "result_revision",
        "validation_revision",
        "occurred_at",
        "time_source",
        "parent_event_id"
      ],
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(unknown|[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
        },
        "result_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(unknown|[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
        },
        "validation_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(unknown|[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
        },
        "time_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "description": "Tool-owned immutable workflow start facts, retained beside the actual outcome."
    }
  }
}
