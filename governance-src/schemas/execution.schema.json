{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated_at",
    "level",
    "task",
    "status",
    "actions",
    "cleanup",
    "validation",
    "findings",
    "governance_feedback",
    "retain_for_audit",
    "durable_summary_recorded"
  ],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "enum": [
        "change-note",
        "engineering",
        "audit"
      ]
    },
    "task": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "in_progress",
        "blocked"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_runs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "scope", "result", "tested_revision"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "scope": {"type": "string", "minLength": 1, "maxLength": 1024},
          "result": {"enum": ["passed", "failed", "partial", "running", "unknown"]},
          "tested_revision": {"type": "string", "minLength": 1, "maxLength": 256},
          "passed": {"type": ["integer", "null"], "minimum": 0},
          "total": {"type": ["integer", "null"], "minimum": 0},
          "later_changes": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
          "pending_retest": {"type": "boolean"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governance_feedback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retain_for_audit": {
      "type": "boolean"
    },
    "durable_summary_recorded": {
      "type": "boolean"
    }
  }
}
