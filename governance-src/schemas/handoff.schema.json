{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated_at",
    "goal",
    "status",
    "completed",
    "in_progress",
    "decisions",
    "invariants",
    "risks",
    "next_actions",
    "validation",
    "canonical_sources"
  ],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "in_progress",
        "blocked"
      ]
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "in_progress": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "run_id", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pointer": {"type": "string", "maxLength": 1024, "pattern": "^(?:/.*)?$"}
      }
    },
    "canonical_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
