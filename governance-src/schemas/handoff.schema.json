{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated_at",
    "goal",
    "status",
    "completed",
    "in_progress",
    "decisions",
    "invariants",
    "risks",
    "next_actions",
    "validation",
    "canonical_sources"
  ],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "in_progress",
        "blocked"
      ]
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "in_progress": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
