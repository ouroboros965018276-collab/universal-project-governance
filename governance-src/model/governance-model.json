{
  "schema_version": 1,
  "name": "universal-project-governance",
  "version": "3.0.0-rc.8",
  "architecture": "compiled-governance",
  "principles": [
    "ONE_SEMANTIC_RULE_ONE_CANONICAL_DEFINITION",
    "CAPABILITY_GROWTH_MUST_NOT_LINEARLY_INCREASE_RUNTIME_LOAD",
    "COMPLEXITY_BELONGS_IN_COMPILER_NOT_AGENT_CONTEXT",
    "NON_TRIVIAL_CHANGE_PREFERS_STRUCTURAL_INTEGRATION_OVER_PATCH_STACKING",
    "STRUCTURAL_INTEGRATION_IS_TASK_BOUNDED_NOT_SCOPE_EXPANSION",
    "CONTINUITY_MUST_BE_RECONSTRUCTABLE_AFTER_UNPLANNED_INTERRUPTION",
    "LEGACY_PROJECT_ADOPTION_MUST_BE_IN_PLACE_AND_NON_DESTRUCTIVE"
  ],
  "hot_path": [
    {
      "id": "ONE_CURRENT_TRUTH",
      "statement": "Reuse one canonical source of truth; update or remove obsolete normative state instead of creating parallel truth."
    },
    {
      "id": "PROPORTIONAL_CLEANUP",
      "statement": "Every project change gets cleanup proportional to its affected neighborhood; remove replaced, duplicate, temporary, or stale residue when safe."
    },
    {
      "id": "EVIDENCE_BEFORE_CLAIM",
      "statement": "Deletion, migration, compatibility, validation, and debt/completion claims require evidence appropriate to the claim."
    },
    {
      "id": "NO_FABRICATION",
      "statement": "Unknown facts stay unknown; never invent history, timestamps, ownership, rationale, validation, deployment state, or consumer intent."
    },
    {
      "id": "NO_UNMANAGED_DEBT",
      "statement": "Safely fixable in-scope debt is fixed; externally blocked debt becomes a bounded exception with risk and removal/review condition."
    },
    {
      "id": "VALIDATE_AFFECTED",
      "statement": "Run the smallest sufficient checks that establish the affected behavior, cleanup, truth, and contract claims."
    },
    {
      "id": "HANDOFF_IF_UNFINISHED",
      "statement": "If work crosses an agent/session boundary or remains unfinished, persist current handoff state when possible; if interruption prevented handoff, the next actor reconstructs from project truth and observable work state without inventing intent."
    },
    {
      "id": "STRUCTURAL_INTEGRATION",
      "statement": "Except for truly local low-risk edits, integrate at the smallest responsible canonical layer and remove superseded patch paths; structural mode never authorizes unrelated redesign, API change, migration, or cleanup outside task scope."
    }
  ],
  "risk_model": {
    "dimensions": {
      "scope": {
        "weight": 1,
        "max": 2
      },
      "reversibility": {
        "weight": 1,
        "max": 2
      },
      "security": {
        "weight": 2,
        "max": 2
      },
      "data": {
        "weight": 2,
        "max": 2
      },
      "external_consumers": {
        "weight": 2,
        "max": 2
      },
      "migration": {
        "weight": 2,
        "max": 2
      },
      "contract_change": {
        "weight": 2,
        "max": 2
      },
      "unknowns": {
        "weight": 1,
        "max": 2
      },
      "handoff": {
        "weight": 1,
        "max": 2
      }
    },
    "levels": [
      {
        "id": "trivial",
        "min": 0,
        "max": 1,
        "report": "none"
      },
      {
        "id": "low",
        "min": 2,
        "max": 3,
        "report": "change-note"
      },
      {
        "id": "medium",
        "min": 4,
        "max": 7,
        "report": "engineering"
      },
      {
        "id": "high",
        "min": 8,
        "max": 99,
        "report": "engineering"
      }
    ],
    "release_operation_forces": "audit"
  },
  "default_rules": [
    "CLEANUP_OBSOLETE",
    "TRUTH_CURRENT",
    "EVIDENCE_AFFECTED"
