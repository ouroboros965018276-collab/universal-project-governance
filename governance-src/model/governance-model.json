    "default_active_policies_max": 5,
    "runtime_markdown_files_max": 4,
    "canonical_definition_per_rule": 1,
    "orphan_policies_max": 0,
    "dependency_cycles_max": 0,
    "conflicting_blocking_rules_max": 0,
    "unused_profile_activations_max": 0,
    "persistent_current_handoffs_max": 1,
    "persistent_current_execution_reports_max": 1,
    "managed_project_files_max": 2
